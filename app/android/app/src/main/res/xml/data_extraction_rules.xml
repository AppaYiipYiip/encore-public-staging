<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing of this app is meant to travel through Android's cloud backup or a
  phone-to-phone transfer (docs/22-friends-sessions-and-your-data.md 4.1,
  ADR-063):
    * the library database is rebuilt from the music server,
    * downloaded songs are gigabytes (Auto Backup stops at 25 MB, silently),
    * the saved login is encrypted with a key that never leaves this phone's
      keystore, so a restored copy could only fail to open.
  What a person wants back after a reinstall (settings, friends, the listening
  history) is kept on their own server by the Encore kit and restored from
  there at the next sign-in.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
