#!/usr/bin/env bash
# The `encore` command: looks after the Encore server the installer put on this computer (docs/tasks P3-05).
#
#   encore status               is it running, at which address, which version
#   encore logs [service]       what the server has been saying (Ctrl-C to stop)
#   encore start | stop | restart
#   encore update               a backup, then the newest version, then check it answers
#   encore funnel on|off|status   let phones reach it away from home (through the Tailscale on this computer)
#   encore backup               a locked copy of the accounts, playlists and likes (kept in /opt/encore/backups, the newest 7)
#   encore restore FILE         put such a copy back (asks for the backup key; what is here now is set aside, not deleted)
#   encore autobackup on|off|status   the nightly backup (on by default)
#   encore secure [--check]     lock the music server's passwords and the backups with keys of this install (--check: is the key you saved the right one)
#   encore uninstall [--everything]   remove it; the music is never touched
# (it asks for the administrator's password itself when it needs it)
set -Eeuo pipefail

DIR="${ENCORE_DIR:-/opt/encore}"
ENCORE_BIN="${ENCORE_BIN:-/usr/local/bin/encore}"

# Everything here needs Docker and the install's private settings, so ask for the administrator's rights once, up front.
if [ "$(id -u)" != 0 ] && [ "${1:-help}" != help ] && [ "${1:-help}" != "--help" ] && [ "${1:-help}" != "-h" ]; then
    exec sudo "$0" "$@"
fi

if [ -t 1 ]; then GREEN=$'\033[32m'; RED=$'\033[31m'; DIM=$'\033[2m'; BOLD=$'\033[1m'; OFF=$'\033[0m'; else GREEN=""; RED=""; DIM=""; BOLD=""; OFF=""; fi
say() { printf '%s\n' "$*"; }
ok() { printf '  %s✓%s %s\n' "$GREEN" "$OFF" "$*"; }
note() { printf '  %s%s%s\n' "$DIM" "$*" "$OFF"; }
die() { printf '\n  %s✗ %s%s\n\n' "$RED" "$*" "$OFF" >&2; exit 1; }

[ -f "$DIR/compose.yaml" ] || die "Encore is not installed here (no $DIR/compose.yaml)."
dc() { docker compose --project-directory "$DIR" "$@"; }
env_value() { grep -E "^$1=" "$DIR/.env" 2>/dev/null | head -1 | cut -d= -f2- || true; }
# Writing one setting of the install (ENV_FILE, by default its .env): replace the line or add it; unset_env removes it. The values are plain addresses,
# never anything with a | or & in it. The file keeps the private mode the installer gave it.
ENV_FILE="${ENV_FILE:-$DIR/.env}"
set_env() { if grep -q "^$1=" "$ENV_FILE" 2>/dev/null; then sed -i "s|^$1=.*|$1=$2|" "$ENV_FILE"; else printf '%s=%s\n' "$1" "$2" >>"$ENV_FILE"; fi; }
unset_env() { sed -i "/^$1=/d" "$ENV_FILE" 2>/dev/null || true; }
PORT="$(env_value ENCORE_PORT)"; PORT="${PORT:-4533}"
need_root() { [ "$(id -u)" = 0 ] || die "This needs the administrator: use  sudo encore $1"; }

answers() { [ "$(curl -s -m 5 -o /dev/null -w '%{http_code}' "http://127.0.0.1:${PORT}/encore/api/v1/info" 2>/dev/null)" = 200 ]; }
wait_answers() {
    for _ in $(seq 1 90); do answers && return 0; sleep 2; done
    return 1
}
# The version is a nicety, never a reason to stop: a server that does not answer (stopped, starting) gives an EMPTY version and status 0. Under `set -Eeuo pipefail` a failing curl here ended
# `encore update` and `encore status` without a word (B-139, found 26 Nov 2026 on a stopped server).
server_version() { { curl -s -m 5 "http://127.0.0.1:${PORT}/encore/api/v1/info" 2>/dev/null | sed -n 's/.*"serverVersion":"\([^"]*\)".*/\1/p' | head -1; } || true; }
host_ip() { ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i <= NF; i++) if ($i == "src") {print $(i + 1); exit}}'; }
# The address the phones are told for this computer on the home network (they also learn it from the server: GET /encore/api/v1/server).
refresh_home_url() { local ip; ip="$(host_ip)"; if [ -n "$ip" ]; then set_env ENCORE_HOME_URL "http://${ip}:${PORT}"; fi; }
state_of() { dc ps --format '{{.Service}} {{.State}} {{.Health}}' 2>/dev/null | awk -v s="$1" '$1 == s {print $2 (NF > 2 && $3 != "" ? " (" $3 ")" : "")}'; }

# Reading the text of `tailscale funnel status` (on standard input). Each site is a line "https://name[:port] (Funnel on)" followed by
# "|-- / proxy http://127.0.0.1:4533". Plain functions of that text, so they are tested without Tailscale (tests/test_deploy_scripts.py).
funnel_port_in_use() { # $1 = 443, 8443 or 10000: is a site already on that public port?
    if [ "$1" = 443 ]; then grep -Eq '^https://[A-Za-z0-9._-]+ \('; else grep -Eq "^https://[A-Za-z0-9._-]+:$1 \("; fi
}
funnel_address_for() { # $1 = the local port: the public address that points at it
    awk -v want="proxy http://127.0.0.1:$1" '/^https:\/\// {site = $1} index($0, want) {print site; exit}'
}
funnel_site_count() { grep -Ec '^https://' || true; }

funnel_address() {
    command -v tailscale >/dev/null 2>&1 || return 0
    local status; status="$(tailscale funnel status 2>/dev/null || true)"
    printf '%s\n' "$status" | funnel_address_for "$PORT"
}

BACKUP_DIR="$(env_value ENCORE_BACKUP_DIR)"; BACKUP_DIR="${BACKUP_DIR:-$DIR/backups}"
KEEP_BACKUPS=7
image_ref() {
    local image tag
    image="$(env_value ENCORE_IMAGE)"; image="${image:-ghcr.io/appayiipyiip/encore-server}"
    tag="$(env_value ENCORE_TAG)"; tag="${tag:-main}"
    printf '%s:%s' "$image" "$tag"
}
# The backups' file names are made here (no spaces or odd characters), newest first.
# A locked backup is the plain one with .age after it (P3-30); backups made before keys existed stay plain files, and both are restored and kept.
# The way back after an update, in one sentence. It needs TWO things together: the program that was running (kept as the local image tag `before-update`, because `dc pull`
# moves the tag `main`, so the old deployment file alone would start the NEW program again, which would migrate the restored data forward once more) and the databases of the
# backup made first.
way_back() {
    local record="$DIR/update-record.txt" file=""
    if [ -f "$record" ]; then file="$(sed -n 's/^backup=//p' "$record" | head -1)"; fi
    printf 'To go back: put ENCORE_TAG=before-update in %s/.env (the program that was running is kept under that name), copy %s/compose.yaml.before-update over %s/compose.yaml, then run  sudo encore restore %s  (the backup made first).' \
        "$DIR" "$DIR" "$DIR" "${file:-FILE}"
}
backups_newest_first() { find "$BACKUP_DIR" -maxdepth 1 \( -name 'encore-backup-*.tar.gz' -o -name 'encore-backup-*.tar.gz.age' \) -printf '%T@ %p\n' 2>/dev/null | sort -rn | cut -d' ' -f2-; }
newest_backup() { backups_newest_first | head -1 || true; }
last_backup_text() {
    local file; file="$(newest_backup)"
    if [ -z "$file" ]; then printf 'none yet (encore backup)'; return; fi
    date -d "@$(stat -c %Y "$file")" '+%Y-%m-%d %H:%M' | tr -d '\n'
    case "$file" in *.age) printf ' (locked)' ;; *) printf ' (NOT locked: run  sudo encore secure)' ;; esac
}
# BEGIN the keys of this install (P3-30) ------------------------------------------------------------------------------------------------------
# The music server keeps every person's password encrypted with a key. With none of its own it uses one that is the same in every install and is in its
# public code, so a stolen copy of its database would open every password. ENCORE_PASSWORD_KEY in .env is this install's own key. Measured on Navidrome
# 0.64.2 (docs/tasks P3-30): set on an install that never had one, every login keeps working (it encrypts them again); a different key, or none,
# afterwards makes EVERY login fail until the right key is back. So the key is made once and never again: a fingerprint of it is written beside the
# music server's data (KEY_MARK) when a start with it has worked, and after that a missing or different key is refused, never replaced.
KEY_MARK="$DIR/navidrome/.encore-password-key.sha256"
BACKUP_PUB="$DIR/backup.pub"
new_secret() { head -c 96 /dev/urandom | base64 -w0 | tr -d '/+=\n' | cut -c1-"$1"; }
password_key_fingerprint() { printf '%s' "$(env_value ENCORE_PASSWORD_KEY)" | sha256sum | cut -d' ' -f1; }
# One word: ok (the key is the one the music server was locked with), unmarked (a key, not yet proved by a start), none (never had one), lost, different.
password_key_state() {
    local key
    key="$(env_value ENCORE_PASSWORD_KEY)"
    if [ -f "$KEY_MARK" ]; then
        if [ -z "$key" ]; then printf lost
        elif [ "$(head -1 "$KEY_MARK")" = "$(password_key_fingerprint)" ]; then printf ok
        else printf different; fi
    elif [ -n "$key" ]; then printf unmarked
    else printf none; fi
}
# Makes the key when this install has never had one; refuses, in words, when it had one and it is gone or changed.
ensure_password_key() {
    case "$(password_key_state)" in
        ok | unmarked) ;;
        none) set_env ENCORE_PASSWORD_KEY "$(new_secret 48)" ;;
        lost) die "The accounts of this install are locked with a key that is no longer in $DIR/.env. A new key would lock everybody out for good. Put the line ENCORE_PASSWORD_KEY=... back (the settings file inside a backup has it: encore restore puts it back), or ask for help." ;;
        different) die "The key in $DIR/.env is not the one the accounts of this install were locked with: it was changed. Put the original back (the settings file inside a backup has it); another key makes every sign-in fail." ;;
    esac
}
# A start that "answers" proves nothing about the key (Encore answers with a wrong one too). This asks the music server, through this server's own door and from this
# computer, to sign in its own administrator with the login in .env: the one check that tests the key against the accounts.
prove_password_key() {
    local user pass salt token answer
    user="$(env_value ENCORE_NAVIDROME_ADMIN_USER)"
    pass="$(env_value ENCORE_NAVIDROME_ADMIN_PASSWORD)"
    [ -n "$user" ] && [ -n "$pass" ] || return 1
    salt="$(new_secret 8)"
    token="$(printf '%s%s' "$pass" "$salt" | md5sum | cut -d' ' -f1)"
    answer="$(curl -s -m 10 "http://127.0.0.1:${PORT}/rest/ping?u=${user}&t=${token}&s=${salt}&v=1.16.1&c=encore&f=json" 2>/dev/null | tr -d ' ' || true)"
    case "$answer" in *'"status":"ok"'*) return 0 ;; *) return 1 ;; esac
}
# Called after a start with the key: when the music server signs its administrator in with it, this key is the one from then on (the mark makes a missing or
# different key a refusal, so it is written only on proof). When it does not, the mark is NOT written and the key can still be put right.
prove_and_confirm_password_key() {
    if [ ! -f "$KEY_MARK" ]; then
        prove_password_key || die "The music server did not accept its own administrator's login with the key of this install, so the key was NOT marked as the right one. See: encore logs. $(way_back)"
        confirm_password_key
    fi
}
# Called after a start with the key has worked: from then on this key is the one.
confirm_password_key() {
    if [ ! -f "$KEY_MARK" ]; then
        mkdir -p "$(dirname "$KEY_MARK")"
        password_key_fingerprint >"$KEY_MARK"
        chmod 600 "$KEY_MARK"
    fi
}
# Before any start: an install whose accounts were locked with a key is not started without it (it would start under the shared key and every sign-in would fail).
guard_password_key() {
    case "$(password_key_state)" in lost | different) ensure_password_key ;; esac
}
backup_is_locked() { [ -s "$BACKUP_PUB" ]; }
# Locks the archive FILE to the public key of this install: FILE.age is made next to it and FILE is removed. The secret half is not on this computer.
lock_archive() {
    local plain="$1"
    backup_tool 0:0 -v "$(dirname "$plain"):/s" -v "$BACKUP_DIR:/b" -v "$BACKUP_PUB:/key/backup.pub:ro" "$(image_ref)" \
        -m encore_server backup --encrypt "/s/$(basename "$plain")" --to /key/backup.pub --out "/b/$(basename "$plain").age" >/dev/null 2>&1 || return 1
    chmod 600 "$BACKUP_DIR/$(basename "$plain").age"
    touch -r "$plain" "$BACKUP_DIR/$(basename "$plain").age"
    rm -f -- "$plain"
}
# The backups made before this install had a backup key are plain files holding the accounts and the keys in the clear: lock them where they are.
lock_old_backups() {
    local f n=0
    backup_is_locked || return 0
    while IFS= read -r f; do
        [ -n "$f" ] || continue
        lock_archive "$f" || die "The older backup $(basename "$f") could not be locked: it is still there, in the clear."
        n=$((n + 1))
    done < <(find "$BACKUP_DIR" -maxdepth 1 -name 'encore-backup-*.tar.gz' 2>/dev/null)
    if [ "$n" -gt 0 ]; then ok "$n older backup(s) were locked too (they held your accounts and keys in the clear)"; fi
}
# The settings file after a restore: this computer's own settings (port, music folder, name) as they are, with what the backup carries over put in the place
# of the same names. Only the backup's key replaces the install's key: a backup made before keys existed carries none, and the install keeps its own.
settings_after_restore() {
    local drop='^ENCORE_NAVIDROME_ADMIN_(USER|PASSWORD)='
    if grep -q '^ENCORE_PASSWORD_KEY=' <<<"$1"; then drop='^(ENCORE_NAVIDROME_ADMIN_(USER|PASSWORD)|ENCORE_PASSWORD_KEY)='; fi
    { grep -vE "$drop" "$DIR/.env" || true; printf '%s\n' "$1"; }
}
# What a restore carries over from the backup's settings file: the music server's administrator login, and the password key when the backup has one.
carried_settings() { grep -E '^(ENCORE_NAVIDROME_ADMIN_(USER|PASSWORD)|ENCORE_PASSWORD_KEY)=' "$1" || true; }
# END the keys of this install -----------------------------------------------------------------------------------------------------------------

# Runs the database tool of the Encore image in a throwaway container with no network, as USER (uid:gid): a copy of a live database must be
# made by the account that owns it, or the -wal and -shm files it may briefly create next to the database would belong to somebody else.
backup_tool() {
    local user="$1"
    shift
    docker run --rm --user "$user" --network none --entrypoint python "$@"
}

cmd_status() {
    local version away
    version="$(server_version)"
    say ""
    say "  ${BOLD}Encore${OFF} ${version:+$version }(version ${TAG:-$(env_value ENCORE_TAG)})"
    for service in encore-server navidrome; do
        local label="Encore server"; [ "$service" = navidrome ] && label="Music server"
        local state; state="$(state_of "$service")"
        if [ -n "$state" ] && [ "${state#running}" != "$state" ]; then ok "$label: $state"; else printf '  %s✗%s %s: %s\n' "$RED" "$OFF" "$label" "${state:-not running}"; fi
    done
    if answers; then ok "It answers on port ${PORT}"; else printf '  %s✗%s It does not answer on port %s (try: encore logs)\n' "$RED" "$OFF" "$PORT"; fi
    if [ -f "$DIR/.setup-pending" ]; then printf '  %s✗%s The first install was cut short before your account was made: run the installer again (sudo bash install.sh).\n' "$RED" "$OFF"; fi
    say ""
    say "        On your home network:  $(host_ip):${PORT}"
    away="$(funnel_address)"
    if [ -n "$away" ]; then say "        Away from home:        $away"; else say "        Away from home:        not set up (encore funnel on)"; fi
    say "        Music folder:          $(env_value ENCORE_MUSIC_DIR)"
    say "        Last backup:           $(last_backup_text)"
    if grep -q ND_PASSWORDENCRYPTIONKEY "$DIR/compose.yaml" && [ -z "$(env_value ENCORE_PASSWORD_KEY)" ]; then printf '  %s✗%s The music server'"'"'s passwords are still stored under the key every install shares: run  sudo encore secure
' "$RED" "$OFF"; fi
    if backup_is_locked; then say "        Backup key:            made $(date -d "@$(stat -c %Y "$BACKUP_PUB")" +%F) (the secret half is not kept on this computer)"; else say "        Backup key:            not made yet (sudo encore secure)"; fi
    say ""
}

cmd_update() {
    need_root update
    local before after image tag
    before="$(server_version)"
    image="$(env_value ENCORE_IMAGE)"; image="${image:-ghcr.io/appayiipyiip/encore-server}"
    tag="$(env_value ENCORE_TAG)"; tag="${tag:-main}"
    say ""
    # A copy of the accounts, playlists and likes first: a new version may change the databases, and the old one cannot read them back.
    if [ -f "$DIR/data/encore.db" ] && [ -f "$DIR/navidrome/navidrome.db" ]; then
        if (cmd_backup --quiet) 2>/dev/null; then ok "A backup was made first"; else note "A backup could not be made first; updating anyway."; fi
    fi
    # The program that is running now stays on this computer under its own name: `dc pull` moves the tag, and going back needs it (way_back).
    if docker image inspect "$image:$tag" >/dev/null 2>&1; then docker tag "$image:$tag" "$image:before-update" >/dev/null 2>&1 || true; fi
    (umask 077 && { echo "made=$(date -u +%Y-%m-%dT%H:%M:%SZ)"; echo "was=${before:-unknown}"; echo "image=$image:before-update"; echo "backup=$(newest_backup)"; } >"$DIR/update-record.txt") || true
    say "  … Looking for a newer version"
    dc pull encore-server >/dev/null 2>&1 || die "The newest version could not be downloaded (are you signed in to the image registry? see: encore logs, or run the installer's sign-in step again)."
    # The deployment files travel in the image: take the ones that match what was just downloaded.
    docker run --rm --entrypoint cat "$image:$tag" /app/deploy/compose.yaml >"$DIR/compose.yaml.new" 2>/dev/null || die "The new version has no deployment files."
    # The new deployment file hands the music server this install's own password key (P3-30). The key is made (or refused, in words) BEFORE anything is replaced.
    local made_key=0
    if grep -q ND_PASSWORDENCRYPTIONKEY "$DIR/compose.yaml.new"; then
        if [ "$(password_key_state)" = none ]; then made_key=1; fi
        ensure_password_key
    fi
    docker run --rm --entrypoint cat "$image:$tag" /app/deploy/encore >"$ENCORE_BIN.new" 2>/dev/null || die "The new version has no encore command."
    cp -p "$DIR/compose.yaml" "$DIR/compose.yaml.before-update"
    mv "$DIR/compose.yaml.new" "$DIR/compose.yaml"
    chmod 755 "$ENCORE_BIN.new"
    refresh_home_url
    dc up -d >/dev/null 2>&1 || die "The new version could not be started. $(way_back)"
    wait_answers || die "The new version did not answer in 3 minutes. See: encore logs. $(way_back)"
    if grep -q ND_PASSWORDENCRYPTIONKEY "$DIR/compose.yaml"; then prove_and_confirm_password_key; fi
    if [ "$made_key" = 1 ]; then note "The music server's passwords are now locked with a key of this install (in $DIR/.env, and in every backup)."; fi
    if ! backup_is_locked; then note "Your backups are not locked yet: run  sudo encore secure  once to lock them and to get the key that opens them."; fi
    after="$(server_version)"
    ok "Encore is up to date${before:+ (was $before, now $after)}"
    # Replacing the file this is running from last: bash has read it already.
    mv "$ENCORE_BIN.new" "$ENCORE_BIN"
}

# The server tells its phones where it can be reached (GET /encore/api/v1/server): remember the away address (or forget it) and let the server read it.
tell_server_away() {
    if [ -n "$1" ]; then set_env ENCORE_AWAY_URL "${1%/}"; else unset_env ENCORE_AWAY_URL; fi
    refresh_home_url
    case "$(password_key_state)" in
        lost | different) note "The server was not restarted: the key its accounts are locked with is missing or changed (run  sudo encore secure  to see what to do)."; return 0 ;;
    esac
    dc up -d >/dev/null 2>&1 || note "The server could not be restarted to learn the new address; it will on the next  encore update."
}

cmd_funnel() {
    need_root funnel
    local what="${1:-status}" port="${PORT}"
    case "$what" in
        on)
            if ! command -v tailscale >/dev/null 2>&1; then
                say ""
                say "  Tailscale is not on this computer. It is what lets your phone reach Encore from anywhere, with a proper https address."
                read -r -p "  Install it now? [Y/n] " answer </dev/tty || answer=n
                case "${answer:-y}" in [Yy]*) curl -fsSL https://tailscale.com/install.sh | sh >/dev/null 2>&1 || die "Tailscale could not be installed." ;; *) die "Without Tailscale there is no way in from outside; nothing was changed." ;; esac
            fi
            if ! tailscale status >/dev/null 2>&1; then
                say "  This computer is not signed in to Tailscale yet. Open the link below in a browser and sign in:"
                tailscale up || die "Signing in to Tailscale did not finish."
            fi
            local status https="" candidate out
            status="$(tailscale funnel status 2>/dev/null || true)"
            if [ -n "$(printf '%s\n' "$status" | funnel_address_for "$port")" ]; then
                tell_server_away "$(funnel_address)"
                ok "Away from home: $(funnel_address) (it was already on)"
                return 0
            fi
            # Another service may already own the public https port 443 of this computer: take the next free one instead of replacing it.
            for candidate in 443 8443 10000; do
                if ! printf '%s\n' "$status" | funnel_port_in_use "$candidate"; then https="$candidate"; break; fi
            done
            [ -n "$https" ] || die "The public ports 443, 8443 and 10000 of this computer are all used by other things. Free one with  tailscale funnel status."
            if [ "$https" != 443 ]; then note "Port 443 is already used by something else here; using ${https}."; fi
            if ! out="$(tailscale funnel --bg --https="$https" "$port" 2>&1)"; then
                printf '%s\n' "$out" | sed 's/^/    /' >&2
                die "Tailscale would not turn Funnel on. It needs HTTPS and Funnel enabled for your tailnet (https://login.tailscale.com/admin/dns)."
            fi
            tell_server_away "$(funnel_address)"
            ok "Away from home: $(funnel_address)"
            note "Phones that are signed in learn this address by themselves, and invitations carry it."
            ;;
        off)
            command -v tailscale >/dev/null 2>&1 || die "Tailscale is not on this computer."
            local status mine
            status="$(tailscale funnel status 2>/dev/null || true)"
            mine="$(printf '%s\n' "$status" | funnel_address_for "$port")"
            if [ -z "$mine" ]; then ok "Encore was not reachable from outside: nothing to turn off"; return 0; fi
            if [ "$(printf '%s\n' "$status" | funnel_site_count)" -le 1 ]; then
                tailscale funnel reset >/dev/null 2>&1 || die "Tailscale would not turn Funnel off."
            else
                # Other things on this computer use Funnel too, and Tailscale's own command has no way to take away one address that works
                # the same in every version: change nothing and say so, rather than reset what is not Encore's.
                die "Other things on this computer use Funnel as well, so nothing was changed. Encore's address is $mine. To take only that one away see  tailscale funnel --help  (or  tailscale funnel reset  removes them all)."
            fi
            tell_server_away ""
            ok "Encore is no longer reachable from outside (Funnel is off)"
            ;;
        status)
            if [ -n "$(funnel_address)" ]; then ok "Away from home: $(funnel_address)"; else say "  Not set up (encore funnel on)"; fi
            ;;
        *) die "Use:  encore funnel on | off | status" ;;
    esac
}

cmd_backup() {
    need_root backup
    local quiet=0 stamp work stage archive
    for arg in "$@"; do
        case "$arg" in --quiet | -q) quiet=1 ;; *) die "Unknown option: $arg" ;; esac
    done
    [ -f "$DIR/data/encore.db" ] || die "Encore has no database yet in $DIR/data: nothing to back up."
    [ -f "$DIR/navidrome/navidrome.db" ] || die "The music server's database was not found in $DIR/navidrome."
    stamp="$(date -u +%Y%m%d-%H%M%S)"
    mkdir -p "$BACKUP_DIR"
    chmod 700 "$BACKUP_DIR"
    find "$BACKUP_DIR" -maxdepth 1 -name 'encore-backup-*.part' -delete 2>/dev/null || true
    work="$(mktemp -d "$DIR/.backup-XXXXXX")"
    stage="$(mktemp -d "$DIR/.backup-stage-XXXXXX")"
    # shellcheck disable=SC2064
    trap "rm -rf -- '$work' '$stage'" EXIT
    if [ "$quiet" != 1 ]; then say ""; say "  … Copying the databases"; fi
    # One run per database, each as the account that owns it, writing into a folder that account may write to.
    local owner
    owner="$(stat -c %u:%g "$DIR/data/encore.db")"
    chown "$owner" "$work"
    backup_tool "$owner" -v "$DIR/data:/data" -v "$work:/out" "$(image_ref)" \
        -m encore_server backup --encore-db /data/encore.db --out /out >"$work/tool.log" 2>&1 \
        || die "The Encore database could not be copied: $(sed -n 's/^backup: //p' "$work/tool.log" | head -1)"
    owner="$(stat -c %u:%g "$DIR/navidrome/navidrome.db")"
    chown "$owner" "$work"
    backup_tool "$owner" -v "$DIR/navidrome:/nd" -v "$work:/out" "$(image_ref)" \
        -m encore_server backup --navidrome-db /nd/navidrome.db --out /out >"$work/tool.log" 2>&1 \
        || die "The music server's database could not be copied: $(sed -n 's/^backup: //p' "$work/tool.log" | head -1)"
    chown 0:0 "$work"
    rm -f "$work/tool.log"
    # The settings file holds the music server's administrator login, which the copied database needs to be opened again.
    cp -p "$DIR/.env" "$work/env"
    {
        echo "format=1"
        echo "made=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        echo "encore=$(server_version)"
        echo "image=$(image_ref)"
    } >"$work/manifest.txt"
    # The archive holds the accounts, the server's private identity key, the key that signs song addresses, the music server's administrator login and its password
    # key (P3-30): it is made in a private staging folder and, when this install has a backup key, only the LOCKED copy ever reaches the backups folder.
    archive="$BACKUP_DIR/encore-backup-$stamp.tar.gz"
    if backup_is_locked; then
        (umask 077 && tar -C "$work" -czf "$stage/encore-backup-$stamp.tar.gz" .)
        lock_archive "$stage/encore-backup-$stamp.tar.gz" || die "The backup could not be locked, so it was not kept (a copy that is not locked would hold your accounts and keys in the clear)."
        archive="$archive.age"
    else
        (umask 077 && tar -C "$work" -czf "$archive.part" . && mv "$archive.part" "$archive")
    fi
    # Keep the newest seven.
    backups_newest_first | tail -n +$((KEEP_BACKUPS + 1)) | while IFS= read -r old; do rm -f -- "$old"; done
    if [ "$quiet" != 1 ]; then
        if backup_is_locked; then
            ok "Backup made and locked: $archive ($(du -h "$archive" | cut -f1))"
            note "It holds the accounts, playlists and likes, and the keys this install needs. Only the backup key you saved can open it. Your music is not in it."
        else
            ok "Backup made: $archive ($(du -h "$archive" | cut -f1))"
            note "It is NOT locked: it holds the accounts, playlists and likes and the keys this install needs, in the clear. Keep it private, and run  sudo encore secure  to lock it."
        fi
        say ""
    fi
}

cmd_restore() {
    need_root restore
    local file="" yes=0 arg key_file_arg=""
    local want_key_file=0
    for arg in "$@"; do
        if [ "$want_key_file" = 1 ]; then key_file_arg="$arg"; want_key_file=0; continue; fi
        case "$arg" in --yes | -y) yes=1 ;; --key-file) want_key_file=1 ;; -*) die "Unknown option: $arg" ;; *) file="$arg" ;; esac
    done
    [ "$want_key_file" = 0 ] || die "--key-file needs the file that holds the backup key."
    [ -n "$file" ] || die "Say which backup:  encore restore FILE   (they are in $BACKUP_DIR; the newest is $(basename "$(newest_backup)" 2>/dev/null))"
    [ -f "$file" ] || die "There is no file $file."
    file="$(realpath -- "$file")"
    local work opened stamp aside made answer f keep key_file="$key_file_arg" secret archive="$file" restored_public=""
    work="$(mktemp -d "$DIR/.restore-XXXXXX")"
    opened="$(mktemp -d "$DIR/.restore-opened-XXXXXX")"
    # shellcheck disable=SC2064
    trap "rm -rf -- '$work' '$opened'" EXIT
    case "$file" in
        *.age)
            # A locked backup: the key is read from a file the Host names or typed here without being shown, never given as part of the command (it would stay in the shell's history).
            if [ -n "$key_file" ]; then secret="$(head -1 "$key_file" 2>/dev/null || true)"; else read -r -s -p "  The backup key (the line that starts with AGE-SECRET-KEY-): " secret </dev/tty || secret=""; say ""; fi
            [ -n "$secret" ] || die "A locked backup needs the backup key that was shown when backups were first protected."
            printf '%s\n' "$secret" | backup_tool 0:0 -i -v "$(dirname "$file"):/s:ro" -v "$opened:/o" "$(image_ref)" \
                -m encore_server backup --decrypt "/s/$(basename "$file")" --out /o/archive.tar.gz >"$opened/tool.log" 2>&1 \
                || { secret=""; die "$(sed -n 's/^backup: //p' "$opened/tool.log" | head -1 | grep . || echo "The backup could not be opened.")"; }
            # The key that opened this backup becomes the one the install's backups are locked with (below, once the restore has worked): backups made from now on
            # are then opened by the key the Host just used, not by one nobody saved.
            restored_public="$(printf '%s\n' "$secret" | backup_tool 0:0 -i "$(image_ref)" -m encore_server backup --public-of 2>/dev/null | sed -n 's/^public=//p' | head -1)"
            secret=""
            archive="$opened/archive.tar.gz"
            ;;
        *) note "This backup is not locked (it was made before backups were locked)." ;;
    esac
    tar -C "$work" -xzf "$archive" 2>/dev/null || die "$file is not a backup this command can read."
    grep -q '^format=1$' "$work/manifest.txt" 2>/dev/null || die "$file is not an Encore backup (or comes from a newer version: run  encore update  first)."
    [ -f "$work/env" ] || die "$file has no settings file."
    backup_tool 0:0 -v "$work:/in" "$(image_ref)" -m encore_server backup --verify /in >"$work/verify.log" 2>&1 \
        || die "This backup is damaged: $(sed -n 's/^backup: //p' "$work/verify.log" | head -1)"
    made="$(sed -n 's/^made=//p' "$work/manifest.txt")"
    keep="$(carried_settings "$work/env")"
    grep -q '^ENCORE_NAVIDROME_ADMIN_PASSWORD=' <<<"$keep" || die "The backup has no administrator login for the music server."
    # A backup that carries the password key needs a deployment file that hands it to the music server; one made before keys existed carries none and keeps this install's own
    # (the music server locks its accounts again with it: measured, P3-30).
    if grep -q '^ENCORE_PASSWORD_KEY=' <<<"$keep" && ! grep -q ND_PASSWORDENCRYPTIONKEY "$DIR/compose.yaml"; then
        die "This backup carries the music server's password key, and this install is older than keys: run  sudo encore update  first, then restore."
    fi
    say ""
    say "  This puts back the accounts, playlists and likes from the backup made ${BOLD}${made}${OFF}."
    say "  What is on this computer now is set aside (not deleted) in $DIR/before-restore-*, and Encore is stopped for a moment."
    if [ "$yes" != 1 ]; then
        read -r -p "  Type  restore  to go on: " answer </dev/tty || answer=""
        [ "$answer" = restore ] || die "Nothing was changed."
    fi
    stamp="$(date -u +%Y%m%d-%H%M%S)"
    aside="$DIR/before-restore-$stamp"
    dc stop >/dev/null 2>&1 || die "Encore could not be stopped."
    mkdir -p "$aside/data" "$aside/navidrome"
    for f in encore.db encore.db-wal encore.db-shm; do if [ -e "$DIR/data/$f" ]; then mv -- "$DIR/data/$f" "$aside/data/$f"; fi; done
    for f in navidrome.db navidrome.db-wal navidrome.db-shm; do if [ -e "$DIR/navidrome/$f" ]; then mv -- "$DIR/navidrome/$f" "$aside/navidrome/$f"; fi; done
    cp -p "$DIR/.env" "$aside/env"
    cp -- "$work/encore.db" "$DIR/data/encore.db"
    cp -- "$work/navidrome.db" "$DIR/navidrome/navidrome.db"
    # The same owner as the files they replace (the copies were made by root; the Encore server runs as an ordinary user and could not write to
    # its own database otherwise). The folder's owner is the fallback when there was nothing to replace.
    for f in data/encore.db navidrome/navidrome.db; do
        if [ -e "$aside/$f" ]; then chown --reference="$aside/$f" "$DIR/$f"; else chown --reference="$DIR/$(dirname "$f")" "$DIR/$f"; fi
    done
    # Only the music server's administrator login and its password key come from the backup: the rest of the settings (port, music folder, name) belong to this computer.
    # The accounts in the copy are locked with the backup's key, so that key replaces this install's and is proved again by the start below.
    if grep -q '^ENCORE_PASSWORD_KEY=' <<<"$keep"; then rm -f "$KEY_MARK"; fi
    settings_after_restore "$keep" >"$DIR/.env.new"
    chmod 600 "$DIR/.env.new"
    mv -- "$DIR/.env.new" "$DIR/.env"
    dc up -d >/dev/null 2>&1 || die "Encore could not be started again. The data from before is in $aside."
    wait_answers || die "Encore did not answer after the restore. See: encore logs. The data from before is in $aside."
    if grep -q ND_PASSWORDENCRYPTIONKEY "$DIR/compose.yaml"; then prove_and_confirm_password_key; fi
    ok "Restored from the backup of ${made}"
    if [ -n "$restored_public" ]; then
        printf '# The key that locks Encore backups: the key of the backup restored on %s. Its secret half is NOT kept on this computer.\n%s\n' "$(date -u +%F)" "$restored_public" >"$BACKUP_PUB"
        chmod 644 "$BACKUP_PUB"
        note "Your backups are now locked with the key you just used, so the one key you saved opens all of them."
    fi
    note "What was here before is in $aside: delete that folder when you are happy with the result."
    say ""
}

# The backup key (P3-30): made once, its public half kept on this computer and its secret half shown ONCE and kept nowhere.
ensure_backup_key() {
    local installer="$1" pair public secret
    if backup_is_locked; then
        ok "Backups are locked (backup key made $(date -d "@$(stat -c %Y "$BACKUP_PUB")" +%F))"
        note "To check you still have the key:  sudo encore secure --check"
        return 0
    fi
    pair="$(backup_tool 0:0 "$(image_ref)" -m encore_server backup --new-key 2>/dev/null)" || die "A backup key could not be made."
    public="$(printf '%s\n' "$pair" | sed -n 's/^public=//p' | head -1)"
    secret="$(printf '%s\n' "$pair" | sed -n 's/^secret=//p' | head -1)"
    pair=""
    [ -n "$public" ] && [ -n "$secret" ] || die "A backup key could not be made."
    printf '# The key that locks Encore backups, made %s. Its secret half is NOT kept on this computer.\n%s\n' "$(date -u +%F)" "$public" >"$BACKUP_PUB"
    chmod 644 "$BACKUP_PUB"
    say ""
    say "  ${BOLD}Your backup key${OFF}. Save it now (a password manager, or on paper in a safe place):"
    say ""
    say "        $secret"
    say ""
    say "  Every backup is locked so that a copy taken away (a USB stick, a cloud folder) or stolen cannot be opened."
    say "  ${BOLD}Encore does not keep this key.${OFF} Without it a backup cannot be opened, by anybody, and nobody can make it again."
    say "  It is shown only this once."
    secret=""
    if [ "$installer" != 1 ]; then
        read -r -p "  Press Enter when you have saved it: " _ </dev/tty || true
    fi
    ok "Backups are locked from now on"
}

# `encore secure`: the two keys of this install (P3-30). Safe to run again: what exists is left alone and said so.
cmd_secure() {
    need_root secure
    local check=0 installer=0 arg
    for arg in "$@"; do
        case "$arg" in --check) check=1 ;; --installer) installer=1 ;; *) die "Use:  encore secure [--check]" ;; esac
    done
    if [ "$check" = 1 ]; then
        backup_is_locked || die "There is no backup key yet: run  sudo encore secure  first."
        local typed
        read -r -s -p "  Paste the backup key you saved (the line that starts with AGE-SECRET-KEY-): " typed </dev/tty || typed=""
        say ""
        [ -n "$typed" ] || die "Nothing was typed."
        if printf '%s\n' "$typed" | backup_tool 0:0 -i -v "$BACKUP_PUB:/key/backup.pub:ro" "$(image_ref)" -m encore_server backup --matches /key/backup.pub >/dev/null 2>&1; then
            ok "That is the key that locks this install's backups."
        else
            die "That is not the key of this install's backups. Look for the one that was shown when backups were first locked."
        fi
        return 0
    fi
    grep -q ND_PASSWORDENCRYPTIONKEY "$DIR/compose.yaml" || die "This install is older than the password key: run  sudo encore update  first (it does this too)."
    say ""
    # 1. The backup key FIRST: the copy taken before the passwords are locked again, and every copy after it, is then locked too.
    ensure_backup_key "$installer"
    # 2. The music server's password key.
    case "$(password_key_state)" in
        none)
            # Locking the accounts again is one way: a copy first, so that nothing is lost if anything goes wrong.
            if [ -f "$DIR/data/encore.db" ] && [ -f "$DIR/navidrome/navidrome.db" ]; then
                (cmd_backup --quiet) 2>/dev/null || die "A backup could not be made first, so nothing was changed."
                ok "A backup was made first"
            fi
            ensure_password_key
            say "  … Locking the music server's passwords with a key of this install"
            dc up -d >/dev/null 2>&1 || die "The music server could not be started with the new key. The key is in $DIR/.env; the backup made first holds the old state."
            wait_answers || die "Encore did not answer after the change. See: encore logs"
            prove_and_confirm_password_key
            ok "The music server's passwords are locked with a key of this install (in $DIR/.env and in every backup)"
            ;;
        ok | unmarked)
            prove_and_confirm_password_key
            ok "The music server's passwords are locked with a key of this install"
            ;;
        *) ensure_password_key ;;
    esac
    # 3. What was made before there was a backup key.
    lock_old_backups
    say ""
}

timer_available() { command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; }
remember_autobackup() {
    if grep -q '^ENCORE_AUTOBACKUP=' "$DIR/.env"; then sed -i "s/^ENCORE_AUTOBACKUP=.*/ENCORE_AUTOBACKUP=$1/" "$DIR/.env"; else echo "ENCORE_AUTOBACKUP=$1" >>"$DIR/.env"; fi
}

cmd_autobackup() {
    need_root autobackup
    case "${1:-status}" in
        on)
            timer_available || die "This computer has no scheduler (systemd) to run it. Run  encore backup  yourself from time to time."
            cat >/etc/systemd/system/encore-backup.service <<'UNIT'
[Unit]
Description=Encore: a copy of the accounts, playlists and likes
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
Environment=ENCORE_DIR=@DIR@
ExecStart=/usr/local/bin/encore backup --quiet
UNIT
            # An install in another folder than /opt/encore must be backed up from there.
            sed -i "s|@DIR@|$DIR|" /etc/systemd/system/encore-backup.service
            cat >/etc/systemd/system/encore-backup.timer <<'UNIT'
[Unit]
Description=Encore: nightly backup

[Timer]
OnCalendar=*-*-* 03:30:00
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
UNIT
            systemctl daemon-reload
            systemctl enable --now encore-backup.timer >/dev/null 2>&1 || die "The nightly backup could not be switched on."
            remember_autobackup 1
            ok "A backup is made every night at about 03:30; the newest $KEEP_BACKUPS are kept in $BACKUP_DIR"
            ;;
        off)
            if timer_available; then
                systemctl disable --now encore-backup.timer >/dev/null 2>&1 || true
                rm -f /etc/systemd/system/encore-backup.timer /etc/systemd/system/encore-backup.service
                systemctl daemon-reload
            fi
            remember_autobackup 0
            ok "The nightly backup is off. Backups already made stay in $BACKUP_DIR"
            ;;
        status)
            if timer_available && systemctl is-enabled encore-backup.timer >/dev/null 2>&1; then
                ok "Nightly backup is on; last one: $(last_backup_text)"
            else
                say "  The nightly backup is off (encore autobackup on)"
            fi
            ;;
        *) die "Use:  encore autobackup on | off | status" ;;
    esac
}

cmd_uninstall() {
    need_root uninstall
    local everything=0 yes=0
    for arg in "$@"; do
        case "$arg" in --everything) everything=1 ;; --yes | -y) yes=1 ;; *) die "Unknown option: $arg" ;; esac
    done
    say ""
    if [ "$everything" = 1 ]; then
        say "  This removes Encore and ${BOLD}everything it remembers${OFF}: accounts, playlists, likes, the music server's database, and the backups made so far."
        say "  Your music folder ($(env_value ENCORE_MUSIC_DIR)) is not touched, including the songs Encore kept in its Encore/ folder."
    else
        say "  This stops and removes Encore. Its data stays in $DIR, so installing again brings everything back. Your music is not touched."
    fi
    if [ "$yes" != 1 ]; then
        read -r -p "  Type  remove  to go on: " answer </dev/tty || answer=""
        [ "$answer" = remove ] || die "Nothing was changed."
    fi
    local image_ref
    image_ref="$(env_value ENCORE_IMAGE):$(env_value ENCORE_TAG)"
    dc down >/dev/null 2>&1 || true
    if timer_available; then
        systemctl disable --now encore-backup.timer >/dev/null 2>&1 || true
        rm -f /etc/systemd/system/encore-backup.timer /etc/systemd/system/encore-backup.service
        systemctl daemon-reload
    fi
    if [ "$everything" = 1 ]; then
        # Never remove a short or odd path: only a folder like /opt/encore that holds this install's own files.
        case "$DIR" in /*/*) ;; *) die "Refusing to remove '$DIR': it does not look like an Encore folder." ;; esac
        if [ ! -f "$DIR/compose.yaml" ] || [ ! -f "$DIR/.env" ]; then die "Refusing to remove '$DIR': it does not hold an Encore install."; fi
        cd /
        rm -rf -- "$DIR"
        docker rmi "$image_ref" >/dev/null 2>&1 || true
        docker rmi "${image_ref%:*}:before-update" >/dev/null 2>&1 || true
    fi
    rm -f /usr/local/bin/encore
    ok "Encore is removed"
}

case "${1:-help}" in
    status) cmd_status ;;
    logs) shift; dc logs --tail 200 -f "$@" ;;
    start) guard_password_key; dc up -d >/dev/null && ok "Started" ;;
    stop) dc stop >/dev/null && ok "Stopped" ;;
    restart) guard_password_key; dc restart >/dev/null && wait_answers && ok "Restarted and answering" ;;
    update) cmd_update ;;
    funnel) shift; cmd_funnel "${1:-status}" ;;
    backup) shift; cmd_backup "$@" ;;
    restore) shift; cmd_restore "$@" ;;
    autobackup) shift; cmd_autobackup "${1:-status}" ;;
    secure) shift; cmd_secure "$@" ;;
    uninstall) shift; cmd_uninstall "$@" ;;
    version) server_version ;;
    help | -h | --help) sed -n '2,$p' "$0" | sed '/^[^#]/,$d' | sed 's/^# \{0,1\}//' ;;
    *) die "Unknown command: $1. Try:  encore help" ;;
esac
