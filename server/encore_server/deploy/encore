#!/usr/bin/env bash
# The `encore` command: looks after the Encore server the installer put on this computer (docs/tasks P3-05).
#
#   encore status               is it running, at which address, which version
#   encore logs [service]       what the server has been saying (Ctrl-C to stop)
#   encore start | stop | restart
#   encore update               a backup, then the newest version, then check it answers
#   encore funnel on|off|status   let phones reach it away from home (through the Tailscale on this computer)
#   encore backup               a copy of the accounts, playlists and likes (kept in /opt/encore/backups, the newest 7)
#   encore restore FILE         put such a copy back (what is here now is set aside, not deleted)
#   encore autobackup on|off|status   the nightly backup (on by default)
#   encore uninstall [--everything]   remove it; the music is never touched
# (it asks for the administrator's password itself when it needs it)
set -Eeuo pipefail

DIR="${ENCORE_DIR:-/opt/encore}"

# Everything here needs Docker and the install's private settings, so ask for the administrator's rights once, up front.
if [ "$(id -u)" != 0 ] && [ "${1:-help}" != help ] && [ "${1:-help}" != "--help" ] && [ "${1:-help}" != "-h" ]; then
    exec sudo "$0" "$@"
fi

if [ -t 1 ]; then GREEN=$'\033[32m'; RED=$'\033[31m'; DIM=$'\033[2m'; BOLD=$'\033[1m'; OFF=$'\033[0m'; else GREEN=""; RED=""; DIM=""; BOLD=""; OFF=""; fi
say() { printf '%s\n' "$*"; }
ok() { printf '  %s✓%s %s\n' "$GREEN" "$OFF" "$*"; }
note() { printf '  %s%s%s\n' "$DIM" "$*" "$OFF"; }
die() { printf '\n  %s✗ %s%s\n\n' "$RED" "$*" "$OFF" >&2; exit 1; }

[ -f "$DIR/compose.yaml" ] || die "Encore is not installed here (no $DIR/compose.yaml)."
dc() { docker compose --project-directory "$DIR" "$@"; }
env_value() { grep -E "^$1=" "$DIR/.env" 2>/dev/null | head -1 | cut -d= -f2- || true; }
PORT="$(env_value ENCORE_PORT)"; PORT="${PORT:-4533}"
need_root() { [ "$(id -u)" = 0 ] || die "This needs the administrator: use  sudo encore $1"; }

answers() { [ "$(curl -s -m 5 -o /dev/null -w '%{http_code}' "http://127.0.0.1:${PORT}/encore/api/v1/info" 2>/dev/null)" = 200 ]; }
wait_answers() {
    for _ in $(seq 1 90); do answers && return 0; sleep 2; done
    return 1
}
server_version() { curl -s -m 5 "http://127.0.0.1:${PORT}/encore/api/v1/info" 2>/dev/null | sed -n 's/.*"serverVersion":"\([^"]*\)".*/\1/p' | head -1; }
host_ip() { ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i <= NF; i++) if ($i == "src") {print $(i + 1); exit}}'; }
state_of() { dc ps --format '{{.Service}} {{.State}} {{.Health}}' 2>/dev/null | awk -v s="$1" '$1 == s {print $2 (NF > 2 && $3 != "" ? " (" $3 ")" : "")}'; }

# Reading the text of `tailscale funnel status` (on standard input). Each site is a line "https://name[:port] (Funnel on)" followed by
# "|-- / proxy http://127.0.0.1:4533". Plain functions of that text, so they are tested without Tailscale (tests/test_deploy_scripts.py).
funnel_port_in_use() { # $1 = 443, 8443 or 10000: is a site already on that public port?
    if [ "$1" = 443 ]; then grep -Eq '^https://[A-Za-z0-9._-]+ \('; else grep -Eq "^https://[A-Za-z0-9._-]+:$1 \("; fi
}
funnel_address_for() { # $1 = the local port: the public address that points at it
    awk -v want="proxy http://127.0.0.1:$1" '/^https:\/\// {site = $1} index($0, want) {print site; exit}'
}
funnel_site_count() { grep -Ec '^https://' || true; }

funnel_address() {
    command -v tailscale >/dev/null 2>&1 || return 0
    local status; status="$(tailscale funnel status 2>/dev/null || true)"
    printf '%s\n' "$status" | funnel_address_for "$PORT"
}

BACKUP_DIR="$(env_value ENCORE_BACKUP_DIR)"; BACKUP_DIR="${BACKUP_DIR:-$DIR/backups}"
KEEP_BACKUPS=7
image_ref() {
    local image tag
    image="$(env_value ENCORE_IMAGE)"; image="${image:-ghcr.io/appayiipyiip/encore-server}"
    tag="$(env_value ENCORE_TAG)"; tag="${tag:-main}"
    printf '%s:%s' "$image" "$tag"
}
# The backups' file names are made here (no spaces or odd characters), newest first.
backups_newest_first() { find "$BACKUP_DIR" -maxdepth 1 -name 'encore-backup-*.tar.gz' -printf '%T@ %p\n' 2>/dev/null | sort -rn | cut -d' ' -f2-; }
newest_backup() { backups_newest_first | head -1 || true; }
last_backup_text() {
    local file; file="$(newest_backup)"
    if [ -z "$file" ]; then printf 'none yet (encore backup)'; return; fi
    date -d "@$(stat -c %Y "$file")" '+%Y-%m-%d %H:%M'
}
# Runs the database tool of the Encore image in a throwaway container with no network, as USER (uid:gid): a copy of a live database must be
# made by the account that owns it, or the -wal and -shm files it may briefly create next to the database would belong to somebody else.
backup_tool() {
    local user="$1"
    shift
    docker run --rm --user "$user" --network none --entrypoint python "$@"
}

cmd_status() {
    local version away
    version="$(server_version)"
    say ""
    say "  ${BOLD}Encore${OFF} ${version:+$version }(version ${TAG:-$(env_value ENCORE_TAG)})"
    for service in encore-server navidrome; do
        local label="Encore server"; [ "$service" = navidrome ] && label="Music server"
        local state; state="$(state_of "$service")"
        if [ -n "$state" ] && [ "${state#running}" != "$state" ]; then ok "$label: $state"; else printf '  %s✗%s %s: %s\n' "$RED" "$OFF" "$label" "${state:-not running}"; fi
    done
    if answers; then ok "It answers on port ${PORT}"; else printf '  %s✗%s It does not answer on port %s (try: encore logs)\n' "$RED" "$OFF" "$PORT"; fi
    if [ -f "$DIR/.setup-pending" ]; then printf '  %s✗%s The first install was cut short before your account was made: run the installer again (sudo bash install.sh).\n' "$RED" "$OFF"; fi
    say ""
    say "        On your home network:  $(host_ip):${PORT}"
    away="$(funnel_address)"
    if [ -n "$away" ]; then say "        Away from home:        $away"; else say "        Away from home:        not set up (encore funnel on)"; fi
    say "        Music folder:          $(env_value ENCORE_MUSIC_DIR)"
    say "        Last backup:           $(last_backup_text)"
    say ""
}

cmd_update() {
    need_root update
    local before after image tag
    before="$(server_version)"
    image="$(env_value ENCORE_IMAGE)"; image="${image:-ghcr.io/appayiipyiip/encore-server}"
    tag="$(env_value ENCORE_TAG)"; tag="${tag:-main}"
    say ""
    # A copy of the accounts, playlists and likes first: a new version may change the databases, and the old one cannot read them back.
    if [ -f "$DIR/data/encore.db" ] && [ -f "$DIR/navidrome/navidrome.db" ]; then
        if (cmd_backup --quiet) 2>/dev/null; then ok "A backup was made first"; else note "A backup could not be made first; updating anyway."; fi
    fi
    say "  … Looking for a newer version"
    dc pull encore-server >/dev/null 2>&1 || die "The newest version could not be downloaded (are you signed in to the image registry? see: encore logs, or run the installer's sign-in step again)."
    # The deployment files travel in the image: take the ones that match what was just downloaded.
    docker run --rm --entrypoint cat "$image:$tag" /app/deploy/compose.yaml >"$DIR/compose.yaml.new" 2>/dev/null || die "The new version has no deployment files."
    docker run --rm --entrypoint cat "$image:$tag" /app/deploy/encore >/usr/local/bin/encore.new 2>/dev/null || die "The new version has no encore command."
    cp -p "$DIR/compose.yaml" "$DIR/compose.yaml.before-update"
    mv "$DIR/compose.yaml.new" "$DIR/compose.yaml"
    chmod 755 /usr/local/bin/encore.new
    dc up -d >/dev/null 2>&1 || die "The new version could not be started. The old files are in $DIR/compose.yaml.before-update."
    wait_answers || die "The new version did not answer in 3 minutes. See: encore logs"
    after="$(server_version)"
    ok "Encore is up to date${before:+ (was $before, now $after)}"
    # Replacing the file this is running from last: bash has read it already.
    mv /usr/local/bin/encore.new /usr/local/bin/encore
}

cmd_funnel() {
    need_root funnel
    local what="${1:-status}" port="${PORT}"
    case "$what" in
        on)
            if ! command -v tailscale >/dev/null 2>&1; then
                say ""
                say "  Tailscale is not on this computer. It is what lets your phone reach Encore from anywhere, with a proper https address."
                read -r -p "  Install it now? [Y/n] " answer </dev/tty || answer=n
                case "${answer:-y}" in [Yy]*) curl -fsSL https://tailscale.com/install.sh | sh >/dev/null 2>&1 || die "Tailscale could not be installed." ;; *) die "Without Tailscale there is no way in from outside; nothing was changed." ;; esac
            fi
            if ! tailscale status >/dev/null 2>&1; then
                say "  This computer is not signed in to Tailscale yet. Open the link below in a browser and sign in:"
                tailscale up || die "Signing in to Tailscale did not finish."
            fi
            local status https="" candidate out
            status="$(tailscale funnel status 2>/dev/null || true)"
            if [ -n "$(printf '%s\n' "$status" | funnel_address_for "$port")" ]; then
                ok "Away from home: $(funnel_address) (it was already on)"
                return 0
            fi
            # Another service may already own the public https port 443 of this computer: take the next free one instead of replacing it.
            for candidate in 443 8443 10000; do
                if ! printf '%s\n' "$status" | funnel_port_in_use "$candidate"; then https="$candidate"; break; fi
            done
            [ -n "$https" ] || die "The public ports 443, 8443 and 10000 of this computer are all used by other things. Free one with  tailscale funnel status."
            if [ "$https" != 443 ]; then note "Port 443 is already used by something else here; using ${https}."; fi
            if ! out="$(tailscale funnel --bg --https="$https" "$port" 2>&1)"; then
                printf '%s\n' "$out" | sed 's/^/    /' >&2
                die "Tailscale would not turn Funnel on. It needs HTTPS and Funnel enabled for your tailnet (https://login.tailscale.com/admin/dns)."
            fi
            ok "Away from home: $(funnel_address)"
            note "Add that address in the Encore app under Your server > Add an address, and invitations will use it."
            ;;
        off)
            command -v tailscale >/dev/null 2>&1 || die "Tailscale is not on this computer."
            local status mine
            status="$(tailscale funnel status 2>/dev/null || true)"
            mine="$(printf '%s\n' "$status" | funnel_address_for "$port")"
            if [ -z "$mine" ]; then ok "Encore was not reachable from outside: nothing to turn off"; return 0; fi
            if [ "$(printf '%s\n' "$status" | funnel_site_count)" -le 1 ]; then
                tailscale funnel reset >/dev/null 2>&1 || die "Tailscale would not turn Funnel off."
            else
                # Other things on this computer use Funnel too, and Tailscale's own command has no way to take away one address that works
                # the same in every version: change nothing and say so, rather than reset what is not Encore's.
                die "Other things on this computer use Funnel as well, so nothing was changed. Encore's address is $mine. To take only that one away see  tailscale funnel --help  (or  tailscale funnel reset  removes them all)."
            fi
            ok "Encore is no longer reachable from outside (Funnel is off)"
            ;;
        status)
            if [ -n "$(funnel_address)" ]; then ok "Away from home: $(funnel_address)"; else say "  Not set up (encore funnel on)"; fi
            ;;
        *) die "Use:  encore funnel on | off | status" ;;
    esac
}

cmd_backup() {
    need_root backup
    local quiet=0 stamp work archive
    for arg in "$@"; do
        case "$arg" in --quiet | -q) quiet=1 ;; *) die "Unknown option: $arg" ;; esac
    done
    [ -f "$DIR/data/encore.db" ] || die "Encore has no database yet in $DIR/data: nothing to back up."
    [ -f "$DIR/navidrome/navidrome.db" ] || die "The music server's database was not found in $DIR/navidrome."
    stamp="$(date -u +%Y%m%d-%H%M%S)"
    mkdir -p "$BACKUP_DIR"
    chmod 700 "$BACKUP_DIR"
    work="$(mktemp -d "$DIR/.backup-XXXXXX")"
    # shellcheck disable=SC2064
    trap "rm -rf -- '$work'" EXIT
    if [ "$quiet" != 1 ]; then say ""; say "  … Copying the databases"; fi
    # One run per database, each as the account that owns it, writing into a folder that account may write to.
    local owner
    owner="$(stat -c %u:%g "$DIR/data/encore.db")"
    chown "$owner" "$work"
    backup_tool "$owner" -v "$DIR/data:/data" -v "$work:/out" "$(image_ref)" \
        -m encore_server backup --encore-db /data/encore.db --out /out >"$work/tool.log" 2>&1 \
        || die "The Encore database could not be copied: $(sed -n 's/^backup: //p' "$work/tool.log" | head -1)"
    owner="$(stat -c %u:%g "$DIR/navidrome/navidrome.db")"
    chown "$owner" "$work"
    backup_tool "$owner" -v "$DIR/navidrome:/nd" -v "$work:/out" "$(image_ref)" \
        -m encore_server backup --navidrome-db /nd/navidrome.db --out /out >"$work/tool.log" 2>&1 \
        || die "The music server's database could not be copied: $(sed -n 's/^backup: //p' "$work/tool.log" | head -1)"
    chown 0:0 "$work"
    rm -f "$work/tool.log"
    # The settings file holds the music server's administrator login, which the copied database needs to be opened again.
    cp -p "$DIR/.env" "$work/env"
    {
        echo "format=1"
        echo "made=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        echo "encore=$(server_version)"
        echo "image=$(image_ref)"
    } >"$work/manifest.txt"
    archive="$BACKUP_DIR/encore-backup-$stamp.tar.gz"
    (umask 077 && tar -C "$work" -czf "$archive.part" . && mv "$archive.part" "$archive")
    # Keep the newest seven.
    backups_newest_first | tail -n +$((KEEP_BACKUPS + 1)) | while IFS= read -r old; do rm -f -- "$old"; done
    if [ "$quiet" != 1 ]; then
        ok "Backup made: $archive ($(du -h "$archive" | cut -f1))"
        note "It holds the accounts, playlists and likes, and a login this install needs: keep it private. Your music is not in it."
        say ""
    fi
}

cmd_restore() {
    need_root restore
    local file="" yes=0 arg
    for arg in "$@"; do
        case "$arg" in --yes | -y) yes=1 ;; -*) die "Unknown option: $arg" ;; *) file="$arg" ;; esac
    done
    [ -n "$file" ] || die "Say which backup:  encore restore FILE   (they are in $BACKUP_DIR; the newest is $(basename "$(newest_backup)" 2>/dev/null))"
    [ -f "$file" ] || die "There is no file $file."
    local work stamp aside made answer f keep
    work="$(mktemp -d "$DIR/.restore-XXXXXX")"
    # shellcheck disable=SC2064
    trap "rm -rf -- '$work'" EXIT
    tar -C "$work" -xzf "$file" 2>/dev/null || die "$file is not a backup this command can read."
    grep -q '^format=1$' "$work/manifest.txt" 2>/dev/null || die "$file is not an Encore backup (or comes from a newer version: run  encore update  first)."
    [ -f "$work/env" ] || die "$file has no settings file."
    backup_tool 0:0 -v "$work:/in" "$(image_ref)" -m encore_server backup --verify /in >"$work/verify.log" 2>&1 \
        || die "This backup is damaged: $(sed -n 's/^backup: //p' "$work/verify.log" | head -1)"
    made="$(sed -n 's/^made=//p' "$work/manifest.txt")"
    keep="$(grep -E '^ENCORE_NAVIDROME_ADMIN_(USER|PASSWORD)=' "$work/env" || true)"
    [ -n "$keep" ] || die "The backup has no administrator login for the music server."
    say ""
    say "  This puts back the accounts, playlists and likes from the backup made ${BOLD}${made}${OFF}."
    say "  What is on this computer now is set aside (not deleted) in $DIR/before-restore-*, and Encore is stopped for a moment."
    if [ "$yes" != 1 ]; then
        read -r -p "  Type  restore  to go on: " answer </dev/tty || answer=""
        [ "$answer" = restore ] || die "Nothing was changed."
    fi
    stamp="$(date -u +%Y%m%d-%H%M%S)"
    aside="$DIR/before-restore-$stamp"
    dc stop >/dev/null 2>&1 || die "Encore could not be stopped."
    mkdir -p "$aside/data" "$aside/navidrome"
    for f in encore.db encore.db-wal encore.db-shm; do if [ -e "$DIR/data/$f" ]; then mv -- "$DIR/data/$f" "$aside/data/$f"; fi; done
    for f in navidrome.db navidrome.db-wal navidrome.db-shm; do if [ -e "$DIR/navidrome/$f" ]; then mv -- "$DIR/navidrome/$f" "$aside/navidrome/$f"; fi; done
    cp -p "$DIR/.env" "$aside/env"
    cp -- "$work/encore.db" "$DIR/data/encore.db"
    cp -- "$work/navidrome.db" "$DIR/navidrome/navidrome.db"
    # The same owner as the files they replace (the copies were made by root; the Encore server runs as an ordinary user and could not write to
    # its own database otherwise). The folder's owner is the fallback when there was nothing to replace.
    for f in data/encore.db navidrome/navidrome.db; do
        if [ -e "$aside/$f" ]; then chown --reference="$aside/$f" "$DIR/$f"; else chown --reference="$DIR/$(dirname "$f")" "$DIR/$f"; fi
    done
    # Only the music server's administrator login comes from the backup: the rest of the settings (port, music folder, name) belong to this computer.
    { grep -vE '^ENCORE_NAVIDROME_ADMIN_(USER|PASSWORD)=' "$DIR/.env"; printf '%s\n' "$keep"; } >"$DIR/.env.new"
    chmod 600 "$DIR/.env.new"
    mv -- "$DIR/.env.new" "$DIR/.env"
    dc up -d >/dev/null 2>&1 || die "Encore could not be started again. The data from before is in $aside."
    wait_answers || die "Encore did not answer after the restore. See: encore logs. The data from before is in $aside."
    ok "Restored from the backup of ${made}"
    note "What was here before is in $aside: delete that folder when you are happy with the result."
    say ""
}

timer_available() { command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; }
remember_autobackup() {
    if grep -q '^ENCORE_AUTOBACKUP=' "$DIR/.env"; then sed -i "s/^ENCORE_AUTOBACKUP=.*/ENCORE_AUTOBACKUP=$1/" "$DIR/.env"; else echo "ENCORE_AUTOBACKUP=$1" >>"$DIR/.env"; fi
}

cmd_autobackup() {
    need_root autobackup
    case "${1:-status}" in
        on)
            timer_available || die "This computer has no scheduler (systemd) to run it. Run  encore backup  yourself from time to time."
            cat >/etc/systemd/system/encore-backup.service <<'UNIT'
[Unit]
Description=Encore: a copy of the accounts, playlists and likes
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
Environment=ENCORE_DIR=@DIR@
ExecStart=/usr/local/bin/encore backup --quiet
UNIT
            # An install in another folder than /opt/encore must be backed up from there.
            sed -i "s|@DIR@|$DIR|" /etc/systemd/system/encore-backup.service
            cat >/etc/systemd/system/encore-backup.timer <<'UNIT'
[Unit]
Description=Encore: nightly backup

[Timer]
OnCalendar=*-*-* 03:30:00
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
UNIT
            systemctl daemon-reload
            systemctl enable --now encore-backup.timer >/dev/null 2>&1 || die "The nightly backup could not be switched on."
            remember_autobackup 1
            ok "A backup is made every night at about 03:30; the newest $KEEP_BACKUPS are kept in $BACKUP_DIR"
            ;;
        off)
            if timer_available; then
                systemctl disable --now encore-backup.timer >/dev/null 2>&1 || true
                rm -f /etc/systemd/system/encore-backup.timer /etc/systemd/system/encore-backup.service
                systemctl daemon-reload
            fi
            remember_autobackup 0
            ok "The nightly backup is off. Backups already made stay in $BACKUP_DIR"
            ;;
        status)
            if timer_available && systemctl is-enabled encore-backup.timer >/dev/null 2>&1; then
                ok "Nightly backup is on; last one: $(last_backup_text)"
            else
                say "  The nightly backup is off (encore autobackup on)"
            fi
            ;;
        *) die "Use:  encore autobackup on | off | status" ;;
    esac
}

cmd_uninstall() {
    need_root uninstall
    local everything=0 yes=0
    for arg in "$@"; do
        case "$arg" in --everything) everything=1 ;; --yes | -y) yes=1 ;; *) die "Unknown option: $arg" ;; esac
    done
    say ""
    if [ "$everything" = 1 ]; then
        say "  This removes Encore and ${BOLD}everything it remembers${OFF}: accounts, playlists, likes, the music server's database, and the backups made so far."
        say "  Your music folder ($(env_value ENCORE_MUSIC_DIR)) is not touched, including the songs Encore kept in its Encore/ folder."
    else
        say "  This stops and removes Encore. Its data stays in $DIR, so installing again brings everything back. Your music is not touched."
    fi
    if [ "$yes" != 1 ]; then
        read -r -p "  Type  remove  to go on: " answer </dev/tty || answer=""
        [ "$answer" = remove ] || die "Nothing was changed."
    fi
    local image_ref
    image_ref="$(env_value ENCORE_IMAGE):$(env_value ENCORE_TAG)"
    dc down >/dev/null 2>&1 || true
    if timer_available; then
        systemctl disable --now encore-backup.timer >/dev/null 2>&1 || true
        rm -f /etc/systemd/system/encore-backup.timer /etc/systemd/system/encore-backup.service
        systemctl daemon-reload
    fi
    if [ "$everything" = 1 ]; then
        # Never remove a short or odd path: only a folder like /opt/encore that holds this install's own files.
        case "$DIR" in /*/*) ;; *) die "Refusing to remove '$DIR': it does not look like an Encore folder." ;; esac
        if [ ! -f "$DIR/compose.yaml" ] || [ ! -f "$DIR/.env" ]; then die "Refusing to remove '$DIR': it does not hold an Encore install."; fi
        cd /
        rm -rf -- "$DIR"
        docker rmi "$image_ref" >/dev/null 2>&1 || true
    fi
    rm -f /usr/local/bin/encore
    ok "Encore is removed"
}

case "${1:-help}" in
    status) cmd_status ;;
    logs) shift; dc logs --tail 200 -f "$@" ;;
    start) dc up -d >/dev/null && ok "Started" ;;
    stop) dc stop >/dev/null && ok "Stopped" ;;
    restart) dc restart >/dev/null && wait_answers && ok "Restarted and answering" ;;
    update) cmd_update ;;
    funnel) shift; cmd_funnel "${1:-status}" ;;
    backup) shift; cmd_backup "$@" ;;
    restore) shift; cmd_restore "$@" ;;
    autobackup) shift; cmd_autobackup "${1:-status}" ;;
    uninstall) shift; cmd_uninstall "$@" ;;
    version) server_version ;;
    help | -h | --help) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die "Unknown command: $1. Try:  encore help" ;;
esac
