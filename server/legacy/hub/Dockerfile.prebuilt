# Only for a machine that is given the finished program instead of building it (the author's own server, whose line is slow: the Dart
# image is several hundred MB). `hub-linux` is `dart compile exe --target-os linux --target-arch x64 bin/hub.dart`. A friend never
# needs this: the compose file builds from source with the Dockerfile next to it.
FROM python:3.12-slim
COPY hub-linux /app/hub
RUN chmod 755 /app/hub
USER 1000:1000
EXPOSE 8703
ENTRYPOINT ["/app/hub"]
